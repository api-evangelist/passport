          "name": "Get converted product prices in selected currency",
          "request": {
            "name": "Get converted product prices in selected currency",
            "description": {
              "content": "E-commerce brands can use the product price endpoint to request product prices in the currency of their choosing. API details:\n- Exchange rates are updated 1/day to ensure product price stability through the day. Brands can also choose to configure static exchange rates of their choosing.\n- Product prices are rounded to 0 decimal places by default, but can be customized on a per currency basis.\n- Product prices use a default display format, but can be customized on a per currency basis.\n",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "product-price"
              ],
              "host": [
                "{{product-price-Url}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "raw",
              "raw": "{\n  \"base_currency\": \"<string>\",\n  \"presentment_currency\": \"<string>\",\n  \"country\": \"<string>\",\n  \"values\": [\n    {\n      \"reference\": \"<string>\",\n      \"value\": \"<number>\"\n    },\n    {\n      \"reference\": \"<string>\",\n      \"value\": \"<number>\"\n    }\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
